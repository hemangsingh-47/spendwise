# SpendWise Backend Environment Configuration Example
# Copy this file to .env and configure your local values

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB: mongodb://localhost:27017/spendwise
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/spendwise?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/spendwise

# Client Origin (CORS whitelist for Expo/React Native development)
CLIENT_ORIGIN=*

# JWT Configuration (Phase 7 Authentication)
JWT_SECRET=spendwise_super_secret_jwt_key_for_development_purposes_only_2026
JWT_EXPIRES_IN=7d
